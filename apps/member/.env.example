# ===========================================================================
# Member app. Copy to apps/member/.env (gitignored).
#
# Expo inlines EXPO_PUBLIC_* into the JS bundle at build time, so treat every
# value here as public. Anything secret belongs in supabase/.env instead.
# ===========================================================================

# Supabase → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co

# Supabase → Project Settings → API → Project API keys → anon / public
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NOT READ YET. The Stripe card sheet is stubbed, and create-setup-intent
# already returns the publishable key from the server. Add this only if you
# wire @stripe/stripe-react-native and want <StripeProvider> configured at
# startup rather than after the first API call.
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
