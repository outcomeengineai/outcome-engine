# ===========================================================================
# Admin dashboard. Copy to apps/admin/.env.local (gitignored).
#
# On Vercel, set these two as Project → Settings → Environment Variables.
#
# Anon key ONLY. The dashboard runs under RLS exactly like a member's session —
# "admin sees everything" comes from the is_admin() policies, not from a
# privileged key in the web app. Never put the service role key here: NEXT_PUBLIC_
# variables are inlined into the browser bundle.
# ===========================================================================

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co

# Supabase → Project Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
