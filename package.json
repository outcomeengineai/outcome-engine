{
  "name": "outcome-engine",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @outcome/shared",
    "test:shared": "npm run test -w @outcome/shared",
    "dev:admin": "npm run dev -w @outcome/admin",
    "dev:member": "npm run start -w @outcome/member",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "fn:serve": "supabase functions serve --no-verify-jwt",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
