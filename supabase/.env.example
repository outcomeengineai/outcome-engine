# ===========================================================================
# Edge Function secrets.
#
# Copy to supabase/.env (gitignored), fill in, then push them:
#
#     supabase secrets set --env-file supabase/.env
#
# This file is NOT loaded at runtime in production — `secrets set` uploads the
# values to Supabase, which injects them into every function. Locally,
# `supabase functions serve` reads supabase/.env directly.
#
# NOT HERE ON PURPOSE: SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY. Supabase injects those into every function
# automatically and REJECTS any secret whose name starts with SUPABASE_.
# ===========================================================================

# --- Scheduled job auth (required) -----------------------------------------
# Any long random string. pg_cron sends it as the x-cron-secret header and the
# scheduled functions reject requests without it, so a leaked function URL is
# not by itself an invocation.
#   openssl rand -hex 32
# The SAME value must also go into Vault as 'cron_secret' — see README.
CRON_SECRET=

# --- Stripe (required before step 8; nothing else needs it) -----------------
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → your endpoint → Signing secret.
# Endpoint URL: https://YOURPROJECT.supabase.co/functions/v1/stripe-webhook
# Events: setup_intent.succeeded, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...
# Returned to the member app by create-setup-intent so the payment sheet can
# initialise. Safe to expose — it is the publishable half.
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- News signal (optional) -------------------------------------------------
# "gdelt" (default, no key, no quota) | "newsapi" | "none"
NEWS_PROVIDER=gdelt
# Only read when NEWS_PROVIDER=newsapi. Leave blank otherwise.
NEWSAPI_KEY=

# --- Kalshi (optional) ------------------------------------------------------
# Only override to point at the demo environment. Public market data needs no
# auth; every member's own trading key is entered in the app and lives in
# Vault, so there is no Kalshi credential in this file at all.
#   demo: https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# --- Expo push (optional) ---------------------------------------------------
# Only needed if you enable Expo's "enhanced security" for push. Without it,
# push still works once eas init has given the app a project id.
EXPO_ACCESS_TOKEN=
